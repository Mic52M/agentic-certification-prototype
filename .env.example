# Copia in .env e completa.
#   cp .env.example .env

# --- Provider LLM (uno dei due è sufficiente; averli entrambi abilita il fallback) ---
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Ordine di provider da usare per il fallback (primo = preferito).
# I provider mancanti (chiave non impostata) vengono saltati automaticamente.
# PROVIDER_PRIORITY=groq,cerebras

# --- Modello ---
# Modello di default (usato da classifier e summarizer). Deve esistere su
# tutti i provider abilitati; il naming per-provider è gestito nel client.
# MODEL=llama-3.3-70b
# Modello del planner (chiamata più corta e strutturata → può essere leggero).
# PLANNER_MODEL=llama-3.1-8b
# TEMPERATURE=0.0

# --- Demo multi-run ---
# EXPERIMENT_RUNS=10
# EXPERIMENT_DELAY_S=0.0

# --- Legacy ---
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MAX_ITERATIONS=10
